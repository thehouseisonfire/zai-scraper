{
  "name": "zai-conversation-scraper",
  "version": "1.3.1",
  "description": "Scrape Z.ai conversations from chat.z.ai and save them as clean Markdown",
  "keywords": [
    "conversation",
    "markdown",
    "playwright",
    "scraper",
    "zai"
  ],
  "homepage": "https://github.com/thehouseisonfire/zai-scraper#readme",
  "bugs": {
    "url": "https://github.com/thehouseisonfire/zai-scraper/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": "thehouseisonfire",
  "repository": {
    "type": "git",
    "url": "https://github.com/thehouseisonfire/zai-scraper.git"
  },
  "bin": {
    "zai-scraper": "./bin/zai-scraper.ts"
  },
  "files": [
    "bin",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "scrape": "bun src/zai-to-markdown.ts",
    "zai-scraper": "bun run ./bin/zai-scraper.ts",
    "test": "bun test --path-ignore-patterns \"dist/**\"",
    "test:node": "node --test src/zai-to-markdown.test.ts src/runtime.test.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/zai-to-markdown.js",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/ README.md package.json tsconfig.json",
    "format:check": "oxfmt --check src/ README.md package.json tsconfig.json",
    "check": "bun run lint && bun run format:check && bun run test && bun run build",
    "prepublishOnly": "bun run check && bun test"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/turndown": "^5.0.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "7"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.0"
}
